# ==============================================================================
# NEXAFLOW CONFIGURATION ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ARC TESTNET NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# RPC endpoint for Arc Testnet (where USDC is the native gas asset)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Deployer wallet private key & public address (Hardhat deployment)
PRIVATE_KEY=your_private_key_here
DEPLOYER_ADDRESS=your_deployer_address_here

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (VITE SUITE)
# ------------------------------------------------------------------------------
# AI Verifier Agent keys for signing EIP-712 claims in-browser
VITE_PRIVATE_KEY=your_private_key_here
VITE_DEPLOYER_ADDRESS=your_deployer_address_here

# Reown AppKit / WalletConnect project ID configuration
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_reown_project_id_here

# ------------------------------------------------------------------------------
# 3. CIRCLE PLATFORM & SDK INTEGRATION
# ------------------------------------------------------------------------------
# Circle Developer Account credentials
CIRCLE_API_KEY=your_circle_developer_api_key_here

# Circle SDK integration keys (App Kit / Bridge Kit)
CIRCLE_KIT_KEY=your_circle_kit_key_here
CIRCLE_CLIENT_KIT_KEY=your_circle_client_kit_key_here
CIRCLE_APP_ID=your_circle_app_id_here

# Entity Secret Cipher used to encrypt and register developer-controlled wallets
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# ------------------------------------------------------------------------------
# 4. AI AGENT ECONOMY CONFIGURATION (LangGraph + OpenAI/DeepSeek)
# ------------------------------------------------------------------------------
# OpenAI / DeepSeek API keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LangSmith / LangChain tracing for agent observability
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="Nexaflow"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="Nexaflow"

# Supabase Database Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Agent server configuration
AGENT_SERVER_PORT=3012

# ------------------------------------------------------------------------------
# 5. ERC-8004 / ERC-8183 AGENTIC ECONOMY CONTRACTS (Arc Testnet)
# ------------------------------------------------------------------------------
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_ADDRESS=0x8004Cb1BF31DAf7788923b405b754f57acEB4272
AGENTIC_COMMERCE_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
