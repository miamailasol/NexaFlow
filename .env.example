# Arc Testnet Configuration
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
PRIVATE_KEY=your_private_key_here

# Circle Platform Credentials (Developer-Controlled Wallets & Compliance)
CIRCLE_API_KEY=your_circle_developer_api_key_here
CIRCLE_COMPLIANCE_API_URL=https://api.circle.com/v1/compliance
VERIFIER_AGENT_ADDRESS=0xyour_circle_developer_wallet_address_here

# Circle User-Controlled Wallets (UCW) Config
CIRCLE_APP_ID=your_circle_app_id_here
NEXT_PUBLIC_CIRCLE_APP_ID=your_circle_app_id_here

# Supabase Persistence Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# LLM Agent Configuration (DeepSeek or OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional Registry Address Overrides (fallback values exist)
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
AGENTIC_COMMERCE_ADDRESS=
